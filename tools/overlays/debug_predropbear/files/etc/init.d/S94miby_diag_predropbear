#!/bin/sh
mkdir -p /usr/data/miby_logs >/dev/null 2>/dev/null || true
LOG=/usr/data/miby_logs/predropbear.log
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [predropbear] diag" >> $LOG 2>/dev/null || true
uname -a >> $LOG 2>/dev/null || true
id >> $LOG 2>/dev/null || true
cat /proc/mounts >> $LOG 2>/dev/null || true
df -h >> $LOG 2>/dev/null || true
cat /etc/passwd >> $LOG 2>/dev/null || true
grep "^root:" /etc/passwd >> $LOG 2>/dev/null || true
ls -la /root >> $LOG 2>/dev/null || true
ls -la /root/.ssh >> $LOG 2>/dev/null || true
ls -la /root/.ssh/authorized_keys >> $LOG 2>/dev/null || true
ls -la /usr/data/dropbear/root/.ssh >> $LOG 2>/dev/null || true
ls -la /usr/data/dropbear/root/.ssh/authorized_keys >> $LOG 2>/dev/null || true
ls -la /etc/dropbear/authorized_keys.default >> $LOG 2>/dev/null || true
ls -la /etc/init.d/S95dropbear >> $LOG 2>/dev/null || true
ls -la /usr/bin/dropbear* >> $LOG 2>/dev/null || true
( sleep 10; exit 0 ) &
exit 0
