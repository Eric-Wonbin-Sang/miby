#!/bin/sh
mkdir -p /usr/data/miby_logs >/dev/null 2>/dev/null || true
LOG=/usr/data/miby_logs/dropbear.log

echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [dropbear] disable requested via sshoff" >> "$LOG" 2>/dev/null || true
rm -f /usr/data/dropbear/enable_ssh
/etc/init.d/S95dropbear stop >> "$LOG" 2>&1 || true
